# Cloudinary - use as mesmas variaveis no ambiente da Vercel
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# Demais variaveis usadas pela API
DATABASE_URL=postgresql://...
JWT_KEY=uma_chave_secreta
JWT_SECRET=uma_chave_secreta
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=senha_de_app
SIGHTENGINE_USER=seu_usuario
SIGHTENGINE_SECRET=seu_secret
FRONTEND_URL=http://localhost:5173
