generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Animal {
  id        Int        @id @default(autoincrement())
  nome      String
  idade     Int
  raca      String
  urlImagem String
  fotos     String[]   @default([])
  tipo      TipoAnimal
  cidade    tipoCidade

  // Código do microchip (letras e números). "Não contém" = sem chip
  chip String @default("Não contém")

  // Localização aproximada do animal
  endereco  String?
  latitude  Float?
  longitude Float?

  arquivado Boolean @default(false)

  usuarioId                Int
  usuario                  Cliente                   @relation(fields: [usuarioId], references: [id]) // RELAÇÃO PADRÃO
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  contatos                 Contato[]
  solicitacoesArquivamento SolicitacaoArquivamento[]
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String
  senha     String
  cpf       String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      String   @default("user")

  animais                  Animal[]
  contatosEnviados         Contato[]                 @relation("ContatoRemetente")
  contatosRecebidos        Contato[]                 @relation("ContatoDestinatario")
  solicitacoesArquivamento SolicitacaoArquivamento[]
  orcamentos               Orcamento[]
}

model Contato {
  id             Int      @id @default(autoincrement())
  mensagem       String
  criadoEm       DateTime @default(now())
  lida           Boolean  @default(false)
  animalId       Int
  remetenteId    Int
  destinatarioId Int
  codigoConversa String

  animal       Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  remetente    Cliente @relation("ContatoRemetente", fields: [remetenteId], references: [id])
  destinatario Cliente @relation("ContatoDestinatario", fields: [destinatarioId], references: [id])

  @@index([animalId])
  @@index([remetenteId])
  @@index([destinatarioId])
}

model Admin {
  id                       Int                       @id @default(autoincrement())
  nome                     String
  email                    String                    @unique
  senha                    String
  role                     String                    @default("admin")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  solicitacoesArquivamento SolicitacaoArquivamento[]
}

model SolicitacaoArquivamento {
  id            Int                           @id @default(autoincrement())
  descricao     String
  resposta      String?
  status        StatusSolicitacaoArquivamento @default(PENDENTE)
  criadoEm      DateTime                      @default(now())
  atualizadoEm  DateTime                      @updatedAt
  animalId      Int
  solicitanteId Int
  adminId       Int?

  animal      Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  solicitante Cliente @relation(fields: [solicitanteId], references: [id])
  admin       Admin?  @relation(fields: [adminId], references: [id])

  @@index([animalId])
  @@index([solicitanteId])
  @@index([status])
}

// Lojas parceiras
model Petshop {
  id                Int         @id @default(autoincrement())
  nome              String
  descricao         String?
  logoUrl           String? // imagem do card (logo ou foto da fachada)
  endereco          String? // ex: Rua Gonçalves Chaves, 100 - Centro
  horario           String? // ex: Seg a Sex, 9h às 18h
  diasFuncionamento String?
  latitude          Float?
  longitude         Float?
  whatsapp          String // só números, com DDI e DDD: 5553999999999
  email             String?     @unique
  senha             String?
  ativo             Boolean     @default(true)
  servicos          Servico[]
  orcamentos        Orcamento[]
  avaliacaoMedia    Float       @default(0)
  totalAvaliacoes   Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Servico {
  id        Int     @id @default(autoincrement())
  nome      String
  descricao String?
  preco     Float? // vazio = "sob consulta"
  ativo     Boolean @default(true)
  petshopId Int
  petshop   Petshop @relation(fields: [petshopId], references: [id], onDelete: Cascade)

  @@index([petshopId])
}

model Orcamento {
  id                  Int             @id @default(autoincrement())
  token               String          @unique
  observacao          String?
  servicosJson        String
  totalEstimado       Float?
  resposta            String?
  dataAgendamento     String?
  horarioAgendamento  String?
  status              StatusOrcamento @default(SOLICITACAO_ABERTA)
  avaliacaoNota       Int?
  avaliacaoComentario String?
  avaliadoEm          DateTime?
  criadoEm            DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt
  petshopId           Int
  clienteId           Int

  petshop Petshop @relation(fields: [petshopId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([petshopId])
  @@index([clienteId])
  @@index([status])
  @@unique([petshopId, dataAgendamento, horarioAgendamento], name: "orcamento_petshop_slot")
}

enum TipoAnimal {
  ADOCAO
  PERDIDO
  ENCONTRADO
}

enum tipoCidade {
  PELOTAS
}

enum StatusSolicitacaoArquivamento {
  PENDENTE
  APROVADA
  RECUSADA
}

enum StatusOrcamento {
  SOLICITACAO_ABERTA
  SERVICO_AGENDADO
  FINALIZADO
  CANCELADO
}
