generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Animal {
  id        Int        @id @default(autoincrement())
  nome      String
  idade     Int
  raca      String
  urlImagem String
  tipo      TipoAnimal
  cidade    tipoCidade

  // Código do microchip (letras e números). "Não contém" = sem chip
  chip      String     @default("Não contém")

  // Localização aproximada do animal
  endereco  String?
  latitude  Float?
  longitude Float?

  usuarioId Int
  usuario   Cliente    @relation(fields: [usuarioId], references: [id]) // RELAÇÃO PADRÃO
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contatos  Contato[]
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String
  senha     String
  cpf       String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      String   @default("user")

  animais           Animal[]
  contatosEnviados  Contato[] @relation("ContatoRemetente")
  contatosRecebidos Contato[] @relation("ContatoDestinatario")
}

model Contato {
  id             Int      @id @default(autoincrement())
  mensagem       String
  criadoEm       DateTime @default(now())
  lida           Boolean  @default(false)
  animalId       Int
  remetenteId    Int
  destinatarioId Int
  codigoConversa String

  animal       Animal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  remetente    Cliente @relation("ContatoRemetente", fields: [remetenteId], references: [id])
  destinatario Cliente @relation("ContatoDestinatario", fields: [destinatarioId], references: [id])

  @@index([animalId])
  @@index([remetenteId])
  @@index([destinatarioId])
}

model Admin {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lojas parceiras
model Petshop {
  id        Int       @id @default(autoincrement())
  nome      String
  descricao String?
  logoUrl   String?   // imagem do card (logo ou foto da fachada)
  endereco  String?   // ex: Rua Gonçalves Chaves, 100 - Centro
  horario   String?   // ex: Seg a Sex, 9h às 18h
  whatsapp  String    // só números, com DDI e DDD: 5553999999999
  ativo     Boolean   @default(true)
  servicos  Servico[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Servico {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  preco     Float?   // vazio = "sob consulta"
  ativo     Boolean  @default(true)
  petshopId Int
  petshop   Petshop  @relation(fields: [petshopId], references: [id], onDelete: Cascade)

  @@index([petshopId])
}

enum TipoAnimal {
  ADOCAO
  PERDIDO
  ENCONTRADO
}

enum tipoCidade {
  PELOTAS
}